{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yalla:activation-challenge-request:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "activation_code",
    "idempotency_key",
    "device"
  ],
  "properties": {
    "api_version": {
      "const": 2
    },
    "activation_code": {
      "type": "string",
      "minLength": 12,
      "maxLength": 96
    },
    "idempotency_key": {
      "type": "string",
      "format": "uuid"
    },
    "device": {
      "$ref": "../../device/device_registration.schema.json"
    }
  }
}
