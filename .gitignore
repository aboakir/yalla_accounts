/android/app/release

# Production/realtime build inputs (real values stay outside source control)
/deploy/production_defines.json
/deploy/*.local.json

# Unified release hygiene: private data and generated artifacts stay outside source.
/output/
/release_evidence/
/.vscode/
/_audit_index/
