{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yalla://contracts/sync/v3/server-change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server_sequence", "change_id", "organization_id", "entity_type", "entity_id",
    "entity_uuid", "operation", "revision", "occurred_at", "payload"
  ],
  "properties": {
    "server_sequence": { "type": "integer", "minimum": 1 },
    "change_id": { "type": "string", "format": "uuid" },
    "organization_id": { "type": "string", "format": "uuid" },
    "entity_type": { "type": "string", "minLength": 1, "maxLength": 80 },
    "entity_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "entity_uuid": { "type": "string", "format": "uuid" },
    "operation": { "enum": ["UPSERT", "DELETE"] },
    "revision": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_device_id": { "type": ["string", "null"], "format": "uuid" }
  }
}
