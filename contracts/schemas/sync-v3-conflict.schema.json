{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yalla://contracts/sync/v3/conflict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conflict_id", "change_id", "entity_uuid", "server_revision",
    "client_base_revision", "reasons", "detected_at", "status"
  ],
  "properties": {
    "conflict_id": { "type": "string", "format": "uuid" },
    "change_id": { "type": "string", "format": "uuid" },
    "entity_uuid": { "type": "string", "format": "uuid" },
    "server_revision": { "type": ["integer", "null"], "minimum": 0 },
    "client_base_revision": { "type": "integer", "minimum": 0 },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 80 } },
    "server_snapshot": { "type": ["object", "null"] },
    "client_payload": { "type": "object" },
    "detected_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["OPEN", "RESOLVED", "SUPERSEDED"] }
  }
}
