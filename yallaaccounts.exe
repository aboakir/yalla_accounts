[Setup]
AppName=Yalla Accounts
AppVersion=1.0
DefaultDirName={pf}\Yalla Accounts
DefaultGroupName=Yalla Accounts
OutputBaseFilename=YallaAccountsSetup
Compression=lzma
SolidCompression=yes

; ضع هنا مسار مجلد Release
SourceDir=F:\flutter_projects\yalla_accounts\build\windows\x64\runner\Release

[Files]
Source: "{#SourcePath}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{commondesktop}\Yalla Accounts"; Filename: "{app}\yalla_accounts.exe"
Name: "{group}\Yalla Accounts"; Filename: "{app}\yalla_accounts.exe"
